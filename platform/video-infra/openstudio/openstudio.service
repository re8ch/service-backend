[Unit]
Description=OpenStudio private radio studio
After=network-online.target icecast2.service coturn.service
Wants=network-online.target

[Service]
Type=simple
User=openstudio
Group=openstudio
WorkingDirectory=/opt/openstudio
EnvironmentFile=/etc/openstudio/openstudio.env
ExecStart=/usr/bin/node /opt/openstudio/server/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openstudio
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
