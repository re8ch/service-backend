# Copy to /etc/re8ch-control-plane-resource-maintenance.env on one host.
# Archive targets are outside K3s, etcd, containerd and Ceph devices.
# A1/B1: /mnt/d/RE8CH-journal-archive/<node>
# R640:  /srv/nas/re8ch-journal-archive/<node>
JOURNAL_ARCHIVE_DIR=/mnt/d/RE8CH-journal-archive/replace-with-node-name
JOURNAL_ARCHIVE_MAX_USE=4G
JOURNAL_ARCHIVE_MAX_DAYS=14
JOURNAL_MAX_USE=512M
