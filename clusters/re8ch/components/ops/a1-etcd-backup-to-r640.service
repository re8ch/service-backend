[Unit]
Description=Encrypt and copy the latest A1 K3s etcd snapshot to R640
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/re8ch/a1-etcd-backup-to-r640.env
ExecStart=/usr/local/sbin/a1-etcd-backup-to-r640
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=idle
