[Unit]
Description=Lightweight Kubernetes Agent (B1 WSL2)
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target zerotier-one.service re8ch-wsl2-network-prerequisites.service

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/%N
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=/sbin/modprobe br_netfilter
ExecStartPre=/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s agent \
  --config /dev/null \
  --server https://10.250.0.1:6443 \
  --token-file /etc/rancher/k3s/agent-token \
  --node-name b1-wsl-zt \
  --node-ip 10.250.0.125 \
  --data-dir /var/lib/rancher/k3s-agent-b1-wsl-zt \
  --node-label pigsty.cc/provider=openstack-wsl \
  --node-label pigsty.cc/region=openstack \
  --node-label pigsty.cc/node-class=worker \
  --node-label pigsty.cc/workload=general \
  --node-label pigsty.cc/zt-ip=10.181.22.125 \
  --node-label re8ch.com/cilium-migrate=true \
  --node-label re8ch.com/control-route=zerotier-primary \
  --node-label re8ch.com/external-ip-mode=none \
  --node-label re8ch.com/network-level=4 \
  --node-label re8ch.com/public-control=none \
  --node-label re8ch.com/public-ip=none \
  --node-label scheduling.re8ch.com/node-profile=worker-small \
  --kubelet-arg max-pods=128 \
  --kubelet-arg kube-reserved=cpu=2,memory=2Gi,ephemeral-storage=2Gi,pid=2048 \
  --kubelet-arg system-reserved=cpu=1,memory=2Gi,ephemeral-storage=2Gi,pid=2048 \
  --kubelet-arg enforce-node-allocatable=pods \
  --kubelet-arg eviction-hard=memory.available<2Gi,nodefs.available<10%,imagefs.available<15%,pid.available<10%
