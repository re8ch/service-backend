[Unit]
Description=RE8CH control-plane bounded resource maintenance
Documentation=https://github.com/re8ch/service-backend/tree/main/clusters/re8ch/components/ops
After=k3s.service
Wants=k3s.service
ConditionPathExists=/etc/rancher/k3s/config.yaml

[Service]
Type=oneshot
EnvironmentFile=-/etc/re8ch-control-plane-resource-maintenance.env
# Automatic maintenance must remain bounded on an embedded-etcd voter. Journal
# export is an explicit operator action; the timer only rotates local storage.
ExecStart=/usr/local/sbin/re8ch-control-plane-resource-maintenance --vacuum-journal
TimeoutStartSec=5min
Nice=19
CPUQuota=5%
MemoryMax=128M
IOSchedulingClass=idle
