+
+export const nativeCapabilitySchema = z.object({
+  plugin: z.string(),
+  groupVersion: z.string(),
+  method: z.string(),
+  path: z.string(),
+  operationId: z.string().optional(),
+  tool: z.string().optional(),
+  registration: z.enum([
+    "implemented_not_deployed",
+    "not_implemented",
+    "deployed",
+  ]),
+  disposition: z.string(),
+  schemaProvenance: z.string(),
+  httpConformance: z.enum(["not_run", "passed", "failed"]),
+  semanticConformance: z.enum(["not_run", "passed", "failed"]),
+});
+
+export const nativeCapabilityInventorySchema = z.object({
+  version: z.literal(1),
+  cluster: z.string(),
+  scope: z.string(),
+  operations: z.array(nativeCapabilitySchema),
+});
+
+export type NativeCapabilityInventory = z.infer<
+  typeof nativeCapabilityInventorySchema
+>;
+
+export function parseNativeCapabilities(server: V0ServerJson) {
+  const metadata = parseStacklokMeta(server);
+  if (!metadata?.success) return null;
+  const inventories = Object.values(metadata.data)
+    .map((transport) => transport.re8ch_capabilities)
+    .filter((value) => value !== undefined);
+  if (inventories.length === 0) return null;
+  // Refuse ambiguous inventories instead of silently dropping a transport.
+  return nativeCapabilityInventorySchema.safeParse(
+    inventories.length === 1 ? inventories[0] : null,
+  );
+}
