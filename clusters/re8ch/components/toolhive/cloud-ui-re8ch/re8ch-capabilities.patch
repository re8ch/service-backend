+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it } from "vitest";
+import { toolDefinitionSchema } from "@/lib/schemas/server-meta";
+import { ServerToolsTable } from "../server-tools-table";
+
+describe("RE8CH native capability tools", () => {
+  it("shows the native contract and expands parameters without claiming acceptance", async () => {
+    const tool = toolDefinitionSchema.parse({
+      name: "anatomy.runtimecommit.list.test",
+      description: "List RuntimeCommits",
+      inputSchema: {
+        type: "object",
+        properties: { namespace: { type: "string" } },
+      },
+      _meta: {
+        re8ch: {
+          plugin: "anatomy",
+          groupVersion: "anatomy.re8ch.com/v1alpha1",
+          operationId: "listRuntimeCommit",
+          method: "GET",
+          path: "/apis/anatomy.re8ch.com/v1alpha1/runtimecommits",
+          schemaHash: "sha256:test",
+          httpConformance: "not_run",
+          semanticConformance: "not_run",
+        },
+      },
+    });
+    render(<ServerToolsTable tools={[tool]} />);
+    expect(screen.getByText("listRuntimeCommit")).toBeVisible();
+    expect(screen.getByText("HTTP: not run")).toBeVisible();
+    expect(screen.getByText("UI semantics: not run")).toBeVisible();
+    expect(screen.queryByText(/passed/i)).not.toBeInTheDocument();
+    const schema = screen.getByText(/"namespace"/);
+    expect(schema).not.toBeVisible();
+    await userEvent.click(screen.getByText("Parameter schema"));
+    expect(schema).toBeVisible();
+  });
+
+  it("keeps legacy tools visible when contract metadata is absent", () => {
+    render(<ServerToolsTable tools={[{ name: "legacy.tool" }]} />);
+    expect(screen.getByText("legacy.tool")).toBeVisible();
+    expect(screen.getAllByText("Not supplied")).toHaveLength(2);
+    expect(screen.queryByText("Parameter schema")).not.toBeInTheDocument();
+  });
+
+  it("shows the empty state", () => {
+    render(<ServerToolsTable tools={[]} />);
+    expect(screen.getByText("No tools available")).toBeVisible();
+  });
+});
