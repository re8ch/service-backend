+"use client";
+
+import { useState } from "react";
+import { Input } from "@/components/ui/input";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@/components/ui/table";
+import type { NativeCapabilityInventory } from "@/lib/schemas/server-meta";
+
+export function NativeCapabilitiesTable({
+  inventory,
+  invalid = false,
+}: {
+  inventory?: NativeCapabilityInventory;
+  invalid?: boolean;
+}) {
+  const [filter, setFilter] = useState("");
+  if (invalid)
+    return (
+      <p role="alert">
+        Capability metadata is invalid. Coverage cannot be assessed.
+      </p>
+    );
+  if (!inventory) return <p>No native capability inventory supplied.</p>;
+  const needle = filter.trim().toLowerCase();
+  const rows = inventory.operations.filter((row) =>
+    Object.values(row).some((value) => value.toLowerCase().includes(needle)),
+  );
+  return (
+    <section className="space-y-4" aria-label="Native capability inventory">
+      <p>Cluster: {inventory.cluster}</p>
+      <p className="text-sm text-muted-foreground">{inventory.scope}</p>
+      <Input
+        aria-label="Filter native capabilities"
+        placeholder="Filter plugin, method, path or status"
+        value={filter}
+        onChange={(event) => setFilter(event.target.value)}
+      />
+      <p role="status">
+        Showing {rows.length} of {inventory.operations.length} inventoried
+        operations
+      </p>
+      <Table>
+        <TableHeader>
+          <TableRow>
+            <TableHead>Native operation</TableHead>
+            <TableHead>Registration</TableHead>
+            <TableHead>Authority and schema</TableHead>
+            <TableHead>Acceptance evidence</TableHead>
+          </TableRow>
+        </TableHeader>
+        <TableBody>
+          {rows.map((row) => (
+            <TableRow key={`${row.groupVersion}:${row.method}:${row.path}`}>
+              <TableCell className="whitespace-normal">
+                <p>
+                  {row.plugin} · {row.groupVersion}
+                </p>
+                <code className="break-all">
+                  {row.method} {row.path}
+                </code>
+                <p className="text-xs break-all">
+                  {row.operationId ?? "Operation ID not extracted"}
+                </p>
+              </TableCell>
+              <TableCell className="whitespace-normal">
+                <p>{row.registration.replaceAll("_", " ")}</p>
+                {row.tool && (
+                  <code className="text-xs break-all">{row.tool}</code>
+                )}
+              </TableCell>
+              <TableCell className="whitespace-normal">
+                <p>{row.disposition.replaceAll("_", " ")}</p>
+                <p>{row.schemaProvenance.replaceAll("_", " ")}</p>
+              </TableCell>
+              <TableCell className="whitespace-normal">
+                <p>HTTP: {row.httpConformance.replaceAll("_", " ")}</p>
+                <p>
+                  UI semantics: {row.semanticConformance.replaceAll("_", " ")}
+                </p>
+              </TableCell>
+            </TableRow>
+          ))}
+          {rows.length === 0 && (
+            <TableRow>
+              <TableCell colSpan={4}>
+                No operations match this filter.
+              </TableCell>
+            </TableRow>
+          )}
+        </TableBody>
+      </Table>
+    </section>
+  );
+}
