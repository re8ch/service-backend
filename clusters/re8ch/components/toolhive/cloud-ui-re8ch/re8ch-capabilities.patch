+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it } from "vitest";
+import {
+  nativeCapabilityInventorySchema,
+  parseNativeCapabilities,
+} from "@/lib/schemas/server-meta";
+import { ServerDetailTabs } from "../server-detail-tabs";
+
+const inventory = nativeCapabilityInventorySchema.parse({
+  version: 1,
+  cluster: "re8ch-k3s",
+  scope: "Selected APIs; other clusters not verified",
+  operations: [
+    {
+      plugin: "anatomy",
+      groupVersion: "apis/anatomy/v1",
+      method: "GET",
+      path: "/runtimecommits",
+      operationId: "listCommits",
+      tool: "anatomy.list",
+      registration: "implemented_not_deployed",
+      disposition: "read",
+      schemaProvenance: "native_openapi",
+      httpConformance: "not_run",
+      semanticConformance: "not_run",
+    },
+    {
+      plugin: "anatomy",
+      groupVersion: "apis/anatomy/v1",
+      method: "PATCH",
+      path: "/runtimecommits/{name}/status",
+      operationId: "patchStatus",
+      registration: "not_implemented",
+      disposition: "controller_owned",
+      schemaProvenance: "native_openapi",
+      httpConformance: "not_run",
+      semanticConformance: "not_run",
+    },
+    {
+      plugin: "mihomos-cluster",
+      groupVersion: "controller/v1",
+      method: "POST",
+      path: "/restart",
+      registration: "not_implemented",
+      disposition: "authority_review_required",
+      schemaProvenance: "source_route_only",
+      httpConformance: "not_run",
+      semanticConformance: "not_run",
+    },
+  ],
+});
+
+function serverWithInventory(value: unknown) {
+  return {
+    _meta: {
+      "io.modelcontextprotocol.registry/publisher-provided": {
+        "io.github.stacklok": {
+          "streamable-http": {
+            re8ch_capabilities: value,
+            tool_definitions: [{ name: "anatomy.list" }],
+          },
+        },
+      },
+    },
+  };
+}
+
+describe("native operation inventory", () => {
+  it("preserves unimplemented operations outside callable tool definitions", () => {
+    const parsed = parseNativeCapabilities(serverWithInventory(inventory));
+    expect(parsed?.success && parsed.data.operations).toEqual(
+      inventory.operations,
+    );
+    expect(parseNativeCapabilities({})).toBeNull();
+    expect(
+      parseNativeCapabilities(serverWithInventory({ ...inventory, version: 2 }))
+        ?.success,
+    ).toBe(false);
+  });
+
+  it("shows all operation states and filters the native capability tab", async () => {
+    render(
+      <ServerDetailTabs
+        tools={[{ name: "anatomy.list" }]}
+        capabilities={inventory}
+      >
+        <p>About</p>
+      </ServerDetailTabs>,
+    );
+    await userEvent.click(
+      screen.getByRole("tab", { name: "Native capabilities" }),
+    );
+    expect(
+      screen.getByText("Showing 3 of 3 inventoried operations"),
+    ).toBeVisible();
+    expect(screen.getByText("controller owned")).toBeVisible();
+    expect(screen.getByText("source route only")).toBeVisible();
+    expect(screen.getByText("implemented not deployed")).toBeVisible();
+    expect(screen.queryByText(/passed/i)).not.toBeInTheDocument();
+    await userEvent.type(
+      screen.getByRole("textbox", { name: "Filter native capabilities" }),
+      "PATCH",
+    );
+    expect(
+      screen.getByText("Showing 1 of 3 inventoried operations"),
+    ).toBeVisible();
+    expect(screen.getByText("patchStatus")).toBeVisible();
+    expect(screen.queryByText("listCommits")).not.toBeInTheDocument();
+    await userEvent.clear(screen.getByRole("textbox"));
+    await userEvent.type(screen.getByRole("textbox"), "absent");
+    expect(screen.getByText("No operations match this filter.")).toBeVisible();
+    await userEvent.click(screen.getByRole("tab", { name: "Tools" }));
+    expect(screen.getByText("anatomy.list")).toBeVisible();
+    expect(screen.queryByText("patchStatus")).not.toBeInTheDocument();
+  });
+
+  it("does not interpret missing inventory as complete coverage", async () => {
+    render(
+      <ServerDetailTabs tools={[]}>
+        <p>About</p>
+      </ServerDetailTabs>,
+    );
+    await userEvent.click(
+      screen.getByRole("tab", { name: "Native capabilities" }),
+    );
+    expect(
+      screen.getByText("No native capability inventory supplied."),
+    ).toBeVisible();
+  });
+
+  it("surfaces invalid metadata instead of showing zero missing operations", async () => {
+    render(
+      <ServerDetailTabs tools={[]} capabilitiesInvalid>
+        <p>About</p>
+      </ServerDetailTabs>,
+    );
+    await userEvent.click(
+      screen.getByRole("tab", { name: "Native capabilities" }),
+    );
+    expect(screen.getByRole("alert")).toHaveTextContent(
+      "Coverage cannot be assessed",
+    );
+  });
+});
