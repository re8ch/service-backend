{
  "apiVersion": "observability.re8ch.com/v1alpha1",
  "kind": "GrafanaMetricFunctionList",
  "metadata": {"name": "re8ch-preset-analysis", "version": "1.0.0"},
  "items": [
    {"id":"pigsty.instance-health","title":"PostgreSQL instance and exporter health","category":"health","chart":"pigsty","queryKind":"promql","expr":"min by (ins) (pg_up{tenant=\"${tenant}\"})","unit":"boolean","analysis":[{"type":"reduce","operation":"min"}]},
    {"id":"pigsty.connections","title":"Database connections by database","category":"connections","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (pg_db_numbackends{tenant=\"${tenant}\"})","unit":"connections","analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.commit-rate","title":"Transaction commit rate","category":"transactions","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_xact_commit{tenant=\"${tenant}\"}[${window}]))","unit":"transactions/sec","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"avg"}]},
    {"id":"pigsty.rollback-rate","title":"Transaction rollback rate","category":"transactions","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_xact_rollback{tenant=\"${tenant}\"}[${window}]))","unit":"transactions/sec","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"avg"}]},
    {"id":"pigsty.rollback-ratio","title":"Rollback ratio","category":"transactions","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_xact_rollback{tenant=\"${tenant}\"}[${window}])) / clamp_min(sum by (datname) (rate(pg_db_xact_commit{tenant=\"${tenant}\"}[${window}]) + rate(pg_db_xact_rollback{tenant=\"${tenant}\"}[${window}])), 0.000001)","unit":"ratio","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.replication-lag","title":"Replication replay lag","category":"replication","chart":"pigsty","queryKind":"promql","expr":"max by (ins,application_name) (pg_repl_replay_lag{tenant=\"${tenant}\"})","unit":"seconds","analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.replication-lag-compat","title":"Replication lag compatibility metric","category":"replication","chart":"pigsty","queryKind":"promql","expr":"max by (ins) (pg_replication_lag{tenant=\"${tenant}\"})","unit":"seconds","analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.exporter-errors","title":"Exporter scrape errors","category":"health","chart":"pigsty","queryKind":"promql","expr":"max by (ins) (pg_exporter_last_scrape_error{tenant=\"${tenant}\"})","unit":"boolean","analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.cache-hit-ratio","title":"Database cache hit ratio","category":"io","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_blks_hit{tenant=\"${tenant}\"}[${window}])) / clamp_min(sum by (datname) (rate(pg_db_blks_hit{tenant=\"${tenant}\"}[${window}]) + rate(pg_db_blks_read{tenant=\"${tenant}\"}[${window}])), 0.000001)","unit":"ratio","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"min"}]},
    {"id":"pigsty.deadlock-rate","title":"Database deadlock rate","category":"locks","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_deadlocks{tenant=\"${tenant}\"}[${window}]))","unit":"deadlocks/sec","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.temp-bytes-rate","title":"Temporary data write rate","category":"io","chart":"pigsty","queryKind":"promql","expr":"sum by (datname) (rate(pg_db_temp_bytes{tenant=\"${tenant}\"}[${window}]))","unit":"bytes/sec","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.database-growth","title":"Database size and growth baseline","category":"capacity","chart":"pigsty","queryKind":"promql","expr":"max by (datname) (pg_db_size_bytes{tenant=\"${tenant}\"})","unit":"bytes","analysis":[{"type":"reduce","operation":"max"}],"indicators":[{"type":"slope"},{"type":"changeRate"}]},
    {"id":"pigsty.wal-rate","title":"WAL generation rate","category":"wal","chart":"pigsty","queryKind":"promql","expr":"sum by (ins) (rate(pg_wal_bytes{tenant=\"${tenant}\"}[${window}]))","unit":"bytes/sec","defaults":{"window":"5m"},"analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"pigsty.checkpoint-rate","title":"Requested and timed checkpoints","category":"checkpoint","chart":"pigsty","queryKind":"promql","queries":[{"refId":"A","expr":"sum by (ins) (rate(pg_checkpoint_timed{tenant=\"${tenant}\"}[${window}]))"},{"refId":"B","expr":"sum by (ins) (rate(pg_checkpoint_req{tenant=\"${tenant}\"}[${window}]))"}],"unit":"checkpoints/sec","defaults":{"window":"5m"}},
    {"id":"pigsty.pvc-utilization","title":"PostgreSQL PVC utilization","category":"capacity","chart":"pigsty","queryKind":"promql","expr":"kubelet_volume_stats_used_bytes{tenant=\"${tenant}\"} / clamp_min(kubelet_volume_stats_capacity_bytes{tenant=\"${tenant}\"}, 1)","unit":"ratio","analysis":[{"type":"reduce","operation":"max"}]},
    {"id":"re8ch.compare-period","title":"Compare a metric with the previous period","category":"analysis","chart":"re8ch-analysis","queryKind":"promql","defaults":{"offset":"1d"},"parameters":{"expression":{"type":"promql-expression","required":true},"offset":{"type":"duration","default":"1d"}},"queries":[{"refId":"current","expr":"${expression}"},{"refId":"previous","expr":"(${expression}) offset ${offset}"}],"unit":"source"},
    {"id":"re8ch.baseline-zscore","title":"Moving baseline and z-score","category":"analysis","chart":"re8ch-analysis","queryKind":"promql","parameters":{"expression":{"type":"promql-expression","required":true}},"expr":"${expression}","unit":"source","indicators":[{"type":"movingAverage","window":12},{"type":"zscore"}]},
    {"id":"re8ch.trend","title":"Slope and change-rate trend","category":"analysis","chart":"re8ch-analysis","queryKind":"promql","parameters":{"expression":{"type":"promql-expression","required":true}},"expr":"${expression}","unit":"source","indicators":[{"type":"slope"},{"type":"changeRate"}]},
    {"id":"re8ch.volatility","title":"Rolling volatility","category":"analysis","chart":"re8ch-analysis","queryKind":"promql","parameters":{"expression":{"type":"promql-expression","required":true}},"expr":"${expression}","unit":"source","indicators":[{"type":"volatility","window":12}]}
  ]
}
