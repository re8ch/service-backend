table ip re8ch_ceph_edge {
    chain ceph_dnat {
        type nat hook prerouting priority dstnat; policy accept;

        # MikroTik owns 10.181.22.128 and DNATs the selected ZeroTier ports to
        # R640's LAN address. Ceph daemons advertise and bind the node's /32
        # identity, so restore that destination only for the Ceph port set.
        iifname "eno2np1" ip daddr 192.168.88.251 tcp dport { 3300, 6789, 6800-7568, 9283 } counter dnat to 10.181.22.128
    }
}
