{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fabric", "pool", "advertisement", "nodes", "mihomoGateway", "advancedFabric"],
  "properties": {
    "fabric": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "stage": {"type": "integer", "minimum": 0},
    "advancedFabric": {
      "type": "object",
      "required": ["enabled", "mode", "applyEnabled", "observeDays", "emergencyDisable", "nativeRoutingCIDR", "acceleratedCIDR", "serviceCIDR", "nodes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["observe-only", "guarded-apply"]},
        "applyEnabled": {"type": "boolean"},
        "observeDays": {"type": "integer", "minimum": 0},
        "emergencyDisable": {"type": "boolean"},
        "timezone": {"type": "string", "const": "Asia/Shanghai"},
        "nativeRoutingCIDR": {"type": "string", "const": "10.42.0.0/16"},
        "acceleratedCIDR": {"type": "string", "const": "10.250.0.0/24"},
        "serviceCIDR": {"type": "string", "const": "10.251.0.0/24"},
        "controlPlaneApi": {
          "type": "object",
          "required": ["enabled", "vip", "port", "mode", "eligibleNodes", "primaryTransport", "fallbackTransport", "healthCheck"],
          "properties": {
            "enabled": {"const": true},
            "vip": {"const": "10.250.0.1/32"},
            "port": {"const": 6443},
            "mode": {"const": "healthy-ecmp"},
            "eligibleNodes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["r640", "a1-wsl-zt", "b1-wsl-zt", "mubao-wsl"]}},
            "guardedNodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["r640", "a1-wsl-zt", "b1-wsl-zt", "mubao-wsl"]}},
            "nodeOperations": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["name", "localAsn", "vipInterface", "frrExportPrefixLists", "wireguardInterfaces"], "properties": {"name": {"enum": ["r640", "a1-wsl-zt", "b1-wsl-zt", "mubao-wsl", "domain-ex", "zan", "muaya-lightweight", "muaya-ecs", "suxunji", "vm-20-12-ubuntu", "overseas-edge-50", "overseas-kl", "overseas-la"]}, "localAsn": {"type": "integer"}, "vipInterface": {"const": "lo"}, "frrExportPrefixLists": {"type": "array", "items": {"type": "string"}}, "wireguardInterfaces": {"type": "array", "items": {"type": "string"}}, "wireguardAllowedPrefixes": {"type": "array", "items": {"type": "string", "pattern": "^10\\.25[01]\\.0\\.[0-9]+/(24|32)$"}}, "fallbackRoutes": {"type": "array", "items": {"type": "object"}}}}},
            "primaryTransport": {"const": "wireguard"},
            "fallbackTransport": {"const": "zerotier"},
            "healthCheck": {"type": "object"}
          }
        },
        "nodes": {"type": "array", "minItems": 8, "items": {"type": "object"}}
      }
    },
    "pool": {
      "type": "object",
      "required": ["cidr", "enabled"],
      "properties": {
        "cidr": {"type": "string", "pattern": "^$|^[0-9.]+/[0-9]+$"},
        "enabled": {"type": "boolean"}
      }
    },
    "mihomoGateway": {
      "type": "object",
      "required": ["enabled", "existingPathsSecret", "service"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingPathsSecret": {"type": "string"},
        "service": {
          "type": "object",
          "required": ["type", "advertise"],
          "properties": {
            "type": {"enum": ["ClusterIP", "LoadBalancer"]},
            "advertise": {"type": "boolean"},
            "requestedLoadBalancerIP": {"type": "string"}
          }
        }
      }
    }
  }
}
