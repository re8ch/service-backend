[Unit]
Description=Expose the r640 local NAS copy before mounting CephFS primary
RequiresMountsFor=/srv/nas
Before=srv-nas-shared.automount srv-nas-shared.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mount --bind /srv/nas/shared /srv/nas-local-fallback
ExecStart=/usr/bin/mount --make-private /srv/nas-local-fallback
ExecStop=/usr/bin/umount /srv/nas-local-fallback

[Install]
WantedBy=multi-user.target
