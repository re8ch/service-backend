    {
      "id": 2,
      "type": "stat",
      "title": "Function Scrape Up",
      "description": "当前成功抓取的函数 pod 数。",
      "datasource": {
        "type": "prometheus",
        "uid": "ds-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "expr": "sum(up{job=\"k8s-nuclio-functions\",tenant=~\"$tenant\",layer=~\"$layer\",category=~\"$category\",service=~\"$service\",function=~\"$function\"})",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
