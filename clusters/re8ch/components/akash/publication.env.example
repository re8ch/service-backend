# Desired records for the existing in-cluster Cloudflare DNS controller.
# They are intentionally not auto-applied by deploy.sh.
DNS_RECORDS="provider-sandbox.akash.re8ch.com=223.159.210.222
*.ingress.provider-sandbox.akash.re8ch.com=223.159.210.222"

# Existing Traefik owns public 80/443 and forwards by Host/SNI to NGF.
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
NGF_HTTP_NODEPORT=30080
NGF_HTTPS_NODEPORT=30443

# MikroTik forwards these public ports directly to the R640 NGF NodePorts.
PUBLIC_PROVIDER_API_PORT=8443
PUBLIC_PROVIDER_GRPC_PORT=8444
NGF_PROVIDER_API_NODEPORT=31443
NGF_PROVIDER_GRPC_NODEPORT=31444
