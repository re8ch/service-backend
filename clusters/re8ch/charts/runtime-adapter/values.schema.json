{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "providers", "publicEdge"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "enabled", "kind", "workloadPrefixes", "priority"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "enabled": {"type": "boolean"},
          "kind": {"enum": ["container", "spin", "wasmedge", "openai", "external-serverless"]},
          "workloadPrefixes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
          "url": {"type": "string"}
        }
      }
    },
    "publicEdge": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}, "hostname": {"type": "string"}}
    }
  }
}

