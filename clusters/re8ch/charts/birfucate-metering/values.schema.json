{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "collectionIntervalSeconds": {"type": "integer", "minimum": 10, "maximum": 3600},
    "prometheus": {
      "type": "object", "required": ["baseURL", "timeoutSeconds"],
      "properties": {"baseURL": {"type": "string", "pattern": "^https?://"}, "writePath": {"type": "string", "pattern": "^/"}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}}
    },
    "usageSink": {
      "type": "object", "required": ["enabled", "url"],
      "properties": {"enabled": {"type": "boolean"}, "url": {"type": "string", "pattern": "^https?://"}, "existingSecret": {"type": "string"}, "tokenKey": {"type": "string"}}
    },
    "meters": {
      "type": "object", "required": ["occupancy", "bifurcation"],
      "properties": {
        "occupancy": {"type": "array", "items": {"$ref": "#/$defs/occupancy"}},
        "bifurcation": {"type": "array", "items": {"$ref": "#/$defs/bifurcation"}}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "domain": {"enum": ["ceph", "pigsty", "networks"]},
    "occupancy": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "domain", "unit", "valueKind", "query"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "domain": {"$ref": "#/$defs/domain"}, "unit": {"type": "string"}, "valueKind": {"const": "gauge"}, "query": {"type": "string", "minLength": 1}}
    },
    "bifurcation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "domain", "occurrenceUnit", "intensityUnit", "referenceIntensity", "countQuery", "intensityQuery", "fanoutQuery"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "domain": {"$ref": "#/$defs/domain"}, "occurrenceUnit": {"type": "string"}, "intensityUnit": {"type": "string"}, "referenceIntensity": {"type": "number", "exclusiveMinimum": 0}, "countQuery": {"type": "string", "minLength": 1}, "intensityQuery": {"type": "string", "minLength": 1}, "fanoutQuery": {"type": "string", "minLength": 1}}
    }
  }
}
