zt.re8ch.com:53 {
    bind {$ZT_DNS_BIND_IP}
    errors
    health :8053
    ready :8054
    file /etc/coredns/db.zt.re8ch.com zt.re8ch.com {
        reload 15s
    }
    cache 30
    reload
    loadbalance
}

.:53 {
    bind {$ZT_DNS_BIND_IP}
    errors
    forward . 192.0.2.58 192.0.2.95 1.1.1.1
    cache 30
    reload
}
