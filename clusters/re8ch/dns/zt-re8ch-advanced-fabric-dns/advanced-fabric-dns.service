[Unit]
Description=Advanced Fabric static authority for zt.re8ch.com
After=network-online.target zerotier-one.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/advanced-fabric-dns/authority.env
ExecStart=/usr/bin/python3 /usr/local/lib/re8ch-advanced-fabric/dns_server.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/advanced-fabric-dns

[Install]
WantedBy=multi-user.target
