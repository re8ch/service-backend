+func (d *driver) rewriteSignedURLHost(signedURL string) (string, error) {
+	if d.RedirectEndpoint == nil {
+		return signedURL, nil
+	}
+
+	u, err := url.Parse(signedURL)
+	if err != nil {
+		return "", fmt.Errorf("failed to parse signed OSS URL: %w", err)
+	}
+	u.Scheme = d.RedirectEndpoint.Scheme
+	u.Host = d.RedirectEndpoint.Host
+	return u.String(), nil
