@@ -0,0 +1,59 @@
+//go:build include_oss
+// +build include_oss
+
+package oss
+
+import (
+	"net/url"
+	"testing"
+)
+
+func TestRewriteSignedURLHost(t *testing.T) {
+	redirectEndpoint, err := url.Parse("https://registry-blob.re8ch.com")
+	if err != nil {
+		t.Fatalf("unexpected redirect endpoint parse error: %v", err)
+	}
+
+	driver := &driver{RedirectEndpoint: redirectEndpoint}
+	signedURL := "https://regitry.oss-cn-hangzhou.aliyuncs.com/harbor-registry/registry/docker/registry/v2/blobs/sha256/58/blob/data?Expires=123&OSSAccessKeyId=ak&Signature=sig"
+
+	rewritten, err := driver.rewriteSignedURLHost(signedURL)
+	if err != nil {
+		t.Fatalf("unexpected rewrite error: %v", err)
+	}
+
+	u, err := url.Parse(rewritten)
+	if err != nil {
+		t.Fatalf("unexpected rewritten URL parse error: %v", err)
+	}
+
+	if u.Scheme != "https" {
+		t.Fatalf("scheme = %q, want https", u.Scheme)
+	}
+	if u.Host != "registry-blob.re8ch.com" {
+		t.Fatalf("host = %q, want registry-blob.re8ch.com", u.Host)
+	}
+	if u.Path != "/harbor-registry/registry/docker/registry/v2/blobs/sha256/58/blob/data" {
+		t.Fatalf("path = %q", u.Path)
+	}
+
+	query := u.Query()
+	for _, key := range []string{"Expires", "OSSAccessKeyId", "Signature"} {
+		if query.Get(key) == "" {
+			t.Fatalf("signed query key %q was not preserved in %q", key, rewritten)
+		}
+	}
+}
+
+func TestRewriteSignedURLHostNoRedirectEndpoint(t *testing.T) {
+	driver := &driver{}
+	signedURL := "https://regitry.oss-cn-hangzhou.aliyuncs.com/object?Expires=123&Signature=sig"
+
+	rewritten, err := driver.rewriteSignedURLHost(signedURL)
+	if err != nil {
+		t.Fatalf("unexpected rewrite error: %v", err)
+	}
+	if rewritten != signedURL {
+		t.Fatalf("rewritten = %q, want original %q", rewritten, signedURL)
+	}
+}
