{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.re8ch.com/testing/mcp-collection-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "testing.re8ch.com/v1alpha1"},
    "kind": {"const": "MCPCollection"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "version": {"type": "string"}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "oauth", "calls"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://"},
        "variables": {"type": "object", "additionalProperties": {"type": "string"}},
        "variableEnv": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "requireSignedEvidence": {"type": "boolean"},
        "oauth": {
          "type": "object", "additionalProperties": false,
          "required": ["resource", "tokenAudience", "protectedResourceMetadata", "tokenEnv", "pkce"],
          "properties": {
            "resource": {"type": "string", "pattern": "^https://"},
            "tokenAudience": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
            "protectedResourceMetadata": {"type": "string", "pattern": "^https://"},
            "tokenEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "pkce": {"const": "S256"}
          }
        },
        "calls": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "tool"],
            "properties": {
              "name": {"type": "string"}, "tool": {"type": "string"}, "arguments": {"type": "object"},
              "capture": {"type": "object", "additionalProperties": {"type": "string"}},
              "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
              "poll": {"$ref": "#/$defs/poll"},
              "cleanup": {"type": "array", "items": {"$ref": "#/$defs/call"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string"}, "equals": {}, "nonEmpty": {"type": "boolean"}}},
    "poll": {"type": "object", "additionalProperties": false, "required": ["maxAttempts", "intervalSeconds"], "properties": {"maxAttempts": {"type": "integer", "minimum": 1, "maximum": 120}, "intervalSeconds": {"type": "number", "minimum": 0, "maximum": 30}}},
    "call": {"type": "object", "additionalProperties": false, "required": ["tool"], "properties": {"name": {"type": "string"}, "tool": {"type": "string"}, "arguments": {"type": "object"}, "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}}
  }
}
}
