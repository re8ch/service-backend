{
  "apiVersion": "governance.re8ch.com/v1alpha1",
  "kind": "GitHubRulesetCanarySet",
  "trackingIssue": "https://github.com/re8ch/service-backend/issues/3337",
  "rollout": {
    "phase": "evaluate",
    "minimumObservationDays": 7,
    "requiredProbes": ["human-pull-request", "dependabot-pull-request", "release-app", "emergency-rollback"],
    "promotionRequires": ["zero-unexplained-failures", "required-check-present", "bypass-readback", "rollback-reviewed"]
  },
  "canaries": [
    {
      "repository": "re8ch/identity-gitops",
      "defaultBranch": "main",
      "requiredCheckEvidence": {
        "pullRequest": "re8ch/identity-gitops#111",
        "headSha": "9cc46c3a810b944302f3b6ef281c91deb09cc58b",
        "check": "render",
        "conclusion": "success",
        "app": "github-actions"
      },
      "ruleset": {
        "name": "tier3-default-branch-evaluate-v1",
        "target": "branch",
        "enforcement": "evaluate",
        "bypass_actors": [],
        "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
        "rules": [
          {"type": "deletion"},
          {"type": "non_fast_forward"},
          {"type": "required_linear_history"},
          {"type": "required_signatures"},
          {"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"], "dismiss_stale_reviews_on_push": true, "require_code_owner_review": false, "require_last_push_approval": false, "required_approving_review_count": 0, "required_review_thread_resolution": true}},
          {"type": "required_status_checks", "parameters": {"do_not_enforce_on_create": true, "required_status_checks": [{"context": "render"}], "strict_required_status_checks_policy": true}}
        ]
      }
    },
    {
      "repository": "pillars-infra/network-gitops",
      "defaultBranch": "main",
      "requiredCheckEvidence": {
        "pullRequest": "pillars-infra/network-gitops#320",
        "headSha": "efe94852f07cd67f9edd2e3ffb103b1ff787416e",
        "check": "render",
        "conclusion": "success",
        "app": "github-actions"
      },
      "ruleset": {
        "name": "tier3-default-branch-evaluate-v1",
        "target": "branch",
        "enforcement": "evaluate",
        "bypass_actors": [],
        "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
        "rules": [
          {"type": "deletion"},
          {"type": "non_fast_forward"},
          {"type": "required_linear_history"},
          {"type": "required_signatures"},
          {"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"], "dismiss_stale_reviews_on_push": true, "require_code_owner_review": false, "require_last_push_approval": false, "required_approving_review_count": 0, "required_review_thread_resolution": true}},
          {"type": "required_status_checks", "parameters": {"do_not_enforce_on_create": true, "required_status_checks": [{"context": "render"}], "strict_required_status_checks_policy": true}}
        ]
      }
    }
  ],
  "pendingAfterCanary": ["siren-observer/observability-gitops", "re8ch/delivery-products-gitops"]
}
