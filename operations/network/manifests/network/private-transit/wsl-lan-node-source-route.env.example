# Install with the stable K3S Node InternalIPs, never the wg-wsl-lan /30.
LOCAL_NODE_IP=10.181.22.147
PEER_NODE_IP=10.181.22.125
# Use the remote peer's public key, never a private key.
PEER_WG_PUBLIC_KEY=replace-with-peer-public-key
# Include only the remote node-owned prefixes. The peer PodCIDR is required
# whenever FRR selects wg-wsl-lan for native-routing Pod traffic. Do not claim
# either the whole 10.250.0.0/24 or 10.42.0.0/16.
PEER_ALLOWED_IPS=172.31.251.2/32,172.18.144.0/20,10.181.22.125/32,10.250.0.125/32,10.42.13.0/24
# Verified path MTU. Raising this without a DF test causes fragmentation loss.
WSL_LAN_MTU=1280
