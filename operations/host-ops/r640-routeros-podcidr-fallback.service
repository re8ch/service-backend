[Unit]
Description=RE8CH R640 aggregate PodCIDR fallback through RouterOS
Wants=network-online.target
After=network-online.target frr.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/ip route replace 10.42.0.0/16 via 192.168.88.1 dev eno2np1 metric 250 proto static
ExecStop=/usr/sbin/ip route del 10.42.0.0/16 via 192.168.88.1 dev eno2np1 metric 250 proto static
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
