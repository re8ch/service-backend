  "openapi": "3.0.3",
  "info": {
    "title": "Mihomo controller native API (partial source-derived contract)",
    "version": "v1.19.29",
    "description": "Partial source-derived native contracts for reviewed controller reads. Common proxy/provider fields are typed; adapter-specific extra properties remain extensible. Remaining routes are tracked in mihomos-native-surfaces.json. No upstream-published OpenAPI is claimed."
  },
