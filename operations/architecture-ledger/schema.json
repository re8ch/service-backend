{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re8ch.com/schemas/cluster-architecture-ledger/v1",
  "type": "object",
  "required": ["schema_version", "revision", "deployment", "architecture", "benchmark", "privacy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision": {
      "type": "object",
      "required": ["id", "source_repository", "source_sha", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "predecessor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["github_deployment_id", "environment", "cluster", "plane", "status", "observed_at", "ssa_receipt", "live_observation"],
      "properties": {
        "github_deployment_id": {"type": "integer", "minimum": 1},
        "environment": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "plane": {"enum": ["cluster-control", "public-service", "private-amongcluster", "application-federation"]},
        "status": {"const": "success"},
        "observed_at": {"type": "string", "format": "date-time"},
        "ssa_receipt": {
          "type": "object",
          "required": ["digest", "target"],
          "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "target": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "live_observation": {
          "type": "object",
          "required": ["digest", "result", "probes"],
          "properties": {
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "result": {"const": "passed"},
            "probes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "result"], "properties": {"name": {"type": "string"}, "result": {"const": "passed"}}, "additionalProperties": false}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["digest", "components"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "version", "digest"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["profile", "profile_digest", "metrics"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["classification", "redacted"],
      "properties": {"classification": {"const": "optimization-dataset"}, "redacted": {"const": true}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
