---
apiVersion: v1
kind: Service
metadata: {name: commerce-postgrest-rw, namespace: payments}
spec: {selector: {app: commerce-postgrest-rw}, ports: [{name: http, port: 3000, targetPort: http}]}
---
apiVersion: v1
kind: Service
metadata: {name: commerce-postgrest-ro, namespace: payments}
spec: {selector: {app: commerce-postgrest-ro}, ports: [{name: http, port: 3000, targetPort: http}]}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: commerce-db-rw, namespace: payments}
spec:
  parentRefs:
    - {name: re8ch-gateway-canary, namespace: kube-system, sectionName: db-rw-https}
    - {name: re8ch-region-loudi, namespace: kube-system, sectionName: db-rw-https}
    - {name: re8ch-region-guangzhou, namespace: kube-system, sectionName: db-rw-https}
    - {name: re8ch-region-shanghai, namespace: kube-system, sectionName: db-rw-https}
    - {name: re8ch-region-hangzhou-nuclio, namespace: kube-system, sectionName: db-rw-https}
    - {name: re8ch-region-shanghai-nuclio, namespace: kube-system, sectionName: db-rw-https}
  hostnames: [db-rw.re8ch.com]
  rules:
    - matches: [{path: {type: PathPrefix, value: /commerce}}]
      filters: [{type: URLRewrite, urlRewrite: {path: {type: ReplacePrefixMatch, replacePrefixMatch: /}}}]
      backendRefs: [{name: commerce-postgrest-rw, port: 3000}]
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: commerce-db-ro, namespace: payments}
spec:
  parentRefs:
    - {name: re8ch-gateway-canary, namespace: kube-system, sectionName: db-ro-https}
    - {name: re8ch-region-loudi, namespace: kube-system, sectionName: db-ro-https}
    - {name: re8ch-region-guangzhou, namespace: kube-system, sectionName: db-ro-https}
    - {name: re8ch-region-shanghai, namespace: kube-system, sectionName: db-ro-https}
    - {name: re8ch-region-hangzhou-nuclio, namespace: kube-system, sectionName: db-ro-https}
    - {name: re8ch-region-shanghai-nuclio, namespace: kube-system, sectionName: db-ro-https}
  hostnames: [db-ro.re8ch.com]
  rules:
    - matches: [{path: {type: PathPrefix, value: /commerce}}]
      filters: [{type: URLRewrite, urlRewrite: {path: {type: ReplacePrefixMatch, replacePrefixMatch: /}}}]
      backendRefs: [{name: commerce-postgrest-ro, port: 3000}]
---
apiVersion: v1
kind: ConfigMap
metadata: {name: nuclio-commerce-api, namespace: payments}
data:
  processor.yaml: |
    metadata:
      name: commerce-api
      namespace: payments
    spec:
      runtime: golang
      handler: main:Handler
      eventTimeout: 300s
      triggers:
        default-http:
          kind: http
          mode: sync
          name: default-http
          attributes:
            serviceType: ClusterIP
            maxRequestBodySize: 1048576
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: nuclio-commerce-api, namespace: payments}
spec:
  replicas: 1
  selector: {matchLabels: {app: commerce-api}}
  template:
    metadata: {labels: {app: commerce-api}}
    spec:
      nodeSelector: {kubernetes.io/hostname: restricted-node-6dc3f140f9}
      securityContext: {runAsNonRoot: true, runAsUser: 10001, seccompProfile: {type: RuntimeDefault}}
      imagePullSecrets: [{name: commerce-registry-pull}]
      containers:
        - name: nuclio
          image: REPLACE_WITH_SIGNED_COMMERCE_IMAGE_DIGEST
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          volumeMounts: [{name: processor-config, mountPath: /etc/nuclio/config/processor, readOnly: true}]
          ports: [{name: http, containerPort: 8080}]
          envFrom: [{secretRef: {name: commerce-api-secrets}}]
          env:
            - {name: NUCLIO_FUNCTION_NAME, value: commerce-api}
            - {name: NUCLIO_FUNCTION_VERSION, value: latest}
            - {name: WX_PAY_MCH_ID, valueFrom: {secretKeyRef: {name: commerce-ruiqi-merchant-certificate, key: WX_PAY_MCH_ID}}}
            - {name: WX_PAY_SERIAL_NO, valueFrom: {secretKeyRef: {name: commerce-ruiqi-merchant-certificate, key: WX_PAY_SERIAL_NO}}}
            - {name: WX_PAY_PRIVATE_KEY, valueFrom: {secretKeyRef: {name: commerce-ruiqi-merchant-certificate, key: WX_PAY_PRIVATE_KEY}}}
            - {name: RE8CH_AUTH_BASE_URL, value: "https://api.re8ch.com/auth"}
            - {name: COMMERCE_RW_URL, value: "https://db-rw.re8ch.com/commerce"}
            - {name: COMMERCE_RO_URL, value: "https://db-ro.re8ch.com/commerce"}
            - {name: WX_PAY_NOTIFY_URL, value: "https://api.re8ch.com/commerce/v1/webhooks/wechat"}
            - {name: COMMERCE_CHECKOUT_ENABLED, value: "false"}
          readinessProbe: {httpGet: {path: /v1/healthz, port: http}, initialDelaySeconds: 5, periodSeconds: 10}
          resources: {requests: {cpu: 100m, memory: 128Mi}, limits: {cpu: "1", memory: 512Mi}}
      volumes: [{name: processor-config, configMap: {name: nuclio-commerce-api}}]
---
apiVersion: v1
kind: Service
metadata: {name: nuclio-commerce-api, namespace: payments}
spec: {selector: {app: commerce-api}, ports: [{name: http, port: 8080, targetPort: http}]}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: commerce-public-api, namespace: payments}
spec:
  parentRefs:
    - {name: re8ch-gateway-canary, namespace: kube-system, sectionName: api-https}
    - {name: re8ch-region-loudi, namespace: kube-system, sectionName: api-https}
    - {name: re8ch-region-guangzhou, namespace: kube-system, sectionName: api-https}
    - {name: re8ch-region-shanghai, namespace: kube-system, sectionName: api-https}
    - {name: re8ch-region-hangzhou-nuclio, namespace: kube-system, sectionName: api-https}
    - {name: re8ch-region-shanghai-nuclio, namespace: kube-system, sectionName: api-https}
  hostnames: [api.re8ch.com]
  rules:
    - matches: [{path: {type: PathPrefix, value: /commerce}}]
      backendRefs: [{name: nuclio-commerce-api, port: 8080}]
---
apiVersion: batch/v1
kind: CronJob
metadata: {name: commerce-wechat-reconcile, namespace: payments}
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      activeDeadlineSeconds: 250
      backoffLimit: 1
      template:
        spec:
          restartPolicy: Never
          nodeSelector: {kubernetes.io/hostname: restricted-node-6dc3f140f9}
          containers:
            - name: reconcile
              image: busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
              env:
                - name: COMMERCE_RECONCILE_TOKEN
                  valueFrom: {secretKeyRef: {name: commerce-api-secrets, key: COMMERCE_RECONCILE_TOKEN}}
              command: [sh, -ec]
              args:
                - 'wget -qO- --header="X-Commerce-Reconcile-Token: ${COMMERCE_RECONCILE_TOKEN}" --post-data="" --timeout=240 http://nuclio-commerce-api.payments.svc.cluster.local:8080/v1/internal/reconcile'
              resources: {requests: {cpu: 5m, memory: 16Mi}, limits: {cpu: 100m, memory: 64Mi}}
