# Template only: pin a signed commerce image and provision named Secrets before moving to clusters/re8ch/components/payments.
# Secrets commerce-postgrest-secrets, commerce-api-secrets and commerce-registry-pull are managed out of band.
apiVersion: apps/v1
kind: Deployment
metadata: {name: commerce-postgrest-rw, namespace: payments}
spec:
  replicas: 1
  selector: {matchLabels: {app: commerce-postgrest-rw}}
  template:
    metadata: {labels: {app: commerce-postgrest-rw}}
    spec:
      nodeSelector: {kubernetes.io/hostname: restricted-node-6dc3f140f9}
      securityContext: {runAsNonRoot: true, runAsUser: 10001, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: postgrest
          image: docker.io/postgrest/postgrest:v14.1@sha256:e9490aa503a5fb07d8e8c80da46e5c0c193894e583b59ed9077e74c4101ffae2
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          ports: [{name: http, containerPort: 3000}]
          env:
            - name: PGRST_DB_URI
              valueFrom: {secretKeyRef: {name: commerce-postgrest-secrets, key: PGRST_DB_URI_RW}}
            - {name: PGRST_DB_SCHEMAS, value: commerce_api}
            - {name: PGRST_DB_ANON_ROLE, value: commerce_anon}
            - name: PGRST_JWT_SECRET
              valueFrom: {secretKeyRef: {name: commerce-postgrest-secrets, key: PGRST_JWT_SECRET}}
          readinessProbe: {httpGet: {path: /, port: http}, initialDelaySeconds: 5, periodSeconds: 10}
          resources: {requests: {cpu: 50m, memory: 64Mi}, limits: {cpu: 500m, memory: 256Mi}}
---
