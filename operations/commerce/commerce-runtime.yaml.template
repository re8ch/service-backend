        - name: postgrest
          image: docker.io/postgrest/postgrest:v14.1@sha256:e9490aa503a5fb07d8e8c80da46e5c0c193894e583b59ed9077e74c4101ffae2
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          ports: [{name: http, containerPort: 3000}]
          env:
            - name: PGRST_DB_URI
              valueFrom: {secretKeyRef: {name: commerce-postgrest-secrets, key: PGRST_DB_URI_RO}}
