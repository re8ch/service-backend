{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/re8ch/service-backend/contracts/agent-presence/claim.schema.json",
  "title": "RE8CH agent work claim",
  "type": "object",
  "required": ["schema", "agent", "runtime", "mode", "intent", "resources",
               "started_at", "heartbeat_at", "ttl_seconds", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "presence.re8ch.com/claim/v1"},
    "agent": {"type": "string", "pattern": "^[a-z0-9-]+/.+$"},
    "runtime": {"type": "string", "minLength": 1},
    "mode": {"enum": ["exclusive", "shared"]},
    "intent": {"type": "string", "minLength": 1, "maxLength": 500},
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+:.+$"}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 28800},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
