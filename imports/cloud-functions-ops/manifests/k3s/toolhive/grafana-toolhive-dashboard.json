{
  "dashboard": {
    "id": null,
    "uid": "toolhive-mcp-control-plane",
    "title": "ToolHive MCP Control Plane",
    "tags": ["toolhive", "mcp", "platform", "security"],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 1,
    "refresh": "30s",
    "time": {"from": "now-6h", "to": "now"},
    "templating": {
      "list": [
        {
          "name": "server",
          "label": "MCP server",
          "type": "query",
          "datasource": {"type": "prometheus", "uid": "ds-prometheus"},
          "query": {"query": "label_values(toolhive_mcp_request_duration_seconds_count, server)", "refId": "server"},
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "refresh": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "MCP request rate by server",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": {"type": "prometheus", "uid": "ds-prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (server) (rate(toolhive_mcp_request_duration_seconds_count{server=~\"$server\"}[5m]))", "legendFormat": "{{server}}"}],
        "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
      },
      {
        "id": 2,
        "title": "MCP error rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": {"type": "prometheus", "uid": "ds-prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (server, status_code) (rate(toolhive_mcp_request_duration_seconds_count{server=~\"$server\",status!=\"success\"}[5m]))", "legendFormat": "{{server}} {{status_code}}"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "continuous-RdYlGr"}}, "overrides": []}
      },
      {
        "id": 3,
        "title": "MCP latency P95",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "datasource": {"type": "prometheus", "uid": "ds-prometheus"},
        "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, server) (rate(toolhive_mcp_request_duration_seconds_bucket{server=~\"$server\"}[5m])))", "legendFormat": "{{server}}"}],
        "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
      },
      {
        "id": 4,
        "title": "Active MCP connections",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "datasource": {"type": "prometheus", "uid": "ds-prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (server) (toolhive_mcp_active_connections{server=~\"$server\"})", "legendFormat": "{{server}}"}],
        "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
      }
    ]
  },
  "folderUid": "",
  "overwrite": true,
  "message": "Provision ToolHive MCP control-plane dashboard"
}
