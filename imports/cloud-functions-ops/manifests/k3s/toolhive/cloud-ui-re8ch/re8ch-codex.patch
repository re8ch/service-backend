+/** Start RE8CH Dex authorization before opening a signed Codex plugin. */
+export function buildCodexInstallUrl(serverName: string): string {
+  const aliases: Record<string, string> = {
+    "cloud-platform-tool": "re8ch-cloud-platform-tool",
+    "re8ch-cloud-platform-tool": "re8ch-cloud-platform-tool",
+    "cluster-infra-tool": "re8ch-cluster-infra-tool",
+    "re8ch-cluster-infra-tool": "re8ch-cluster-infra-tool",
+    "agent-orchestra-collab": "re8ch-agent-orchestra-collab",
+    "re8ch-agent-orchestra-collab": "re8ch-agent-orchestra-collab",
+  };
+  const suffix = (serverName.split("/").pop() ?? serverName).toLowerCase();
+  const plugin = aliases[suffix] ?? suffix;
+  const query = new URLSearchParams({ plugin, channel: "codex" });
+  return `https://marketplace.re8ch.com/install/authorize?${query.toString()}`;
+}
