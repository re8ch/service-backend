[Unit]
Description=Prepare B1 WSL2 VirtioProxy networking for RE8CH K3s
After=zerotier-one.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mount --make-rshared /
# VirtioProxy installs priority-1 TCP/UDP rules for tables 127/128. Without
# this earlier exception, localhost TCP is incorrectly routed to loopback0.
ExecStart=-/usr/sbin/ip rule add priority 0 to 127.0.0.0/8 lookup local
ExecStart=/bin/sh -c 'i=0; while ! /usr/sbin/ip link show zto5uhdriy >/dev/null 2>&1; do i=$$((i+1)); test $$i -ge 30 && exit 1; sleep 1; done; /usr/sbin/ip link set dev zto5uhdriy mtu 1280'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
