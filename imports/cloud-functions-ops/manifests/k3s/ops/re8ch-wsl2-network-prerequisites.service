[Unit]
Description=Prepare WSL2 networking and mount propagation for RE8CH K3s
After=zerotier-one.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mount --make-rshared /
ExecStart=/usr/sbin/ip link set dev zto5uhdriy mtu 1280
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
