[Unit]
Description=RE8CH restricted-node-6dc3f140f9 Ceph ports behind MikroTik ZeroTier identity
Wants=network-online.target
After=network-online.target re8ch-zt128-dummy.service
Before=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table ip re8ch_ceph_edge
ExecStart=/usr/sbin/nft -f /etc/rook-ceph/r640-ceph-edge.nft
ExecStop=-/usr/sbin/nft delete table ip re8ch_ceph_edge

[Install]
WantedBy=multi-user.target
