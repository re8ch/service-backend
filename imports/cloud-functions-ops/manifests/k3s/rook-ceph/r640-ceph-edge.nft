table ip re8ch_ceph_edge {
    chain ceph_dnat {
        type nat hook prerouting priority dstnat; policy accept;

        # MikroTik owns 192.0.2.183 and DNATs the selected ZeroTier ports to
        # restricted-node-6dc3f140f9's LAN address. Ceph daemons advertise and bind the node's /32
        # identity, so restore that destination only for the Ceph port set.
        iifname "eno2np1" ip daddr 192.0.2.97 tcp dport { 3300, 6789, 6800-7568, 9283 } counter dnat to 192.0.2.183
    }
}
