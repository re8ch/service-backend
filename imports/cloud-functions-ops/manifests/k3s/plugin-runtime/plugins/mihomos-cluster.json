{
  "apiVersion": "plugins.re8ch.com/v1alpha1",
  "kind": "PluginDefinition",
  "metadata": {"name": "mihomos-cluster"},
  "spec": {
    "source": {"type": "kubernetes"},
    "discovery": {"mode": "api-discovery"},
    "identityRef": "plugin-mihomos-cluster",
    "healthCheck": {"type": "kubernetes", "resource": "daemonsets.apps", "namespace": "egress-fabric"},
    "policy": {
      "allowedOperations": ["get", "list", "patch"],
      "deniedFields": ["secret", "password", "token", "privateKey", "clientSecret", "apiKey"],
      "resourceScopes": [
        {"group": "apps", "version": "v1", "resource": "daemonsets", "namespaced": true, "namespaces": ["egress-fabric"], "verbs": ["get", "list"]},
        {"group": "", "version": "v1", "resource": "configmaps", "namespaced": true, "namespaces": ["egress-fabric"], "verbs": ["get", "list", "patch"]},
        {"group": "", "version": "v1", "resource": "nodes", "namespaced": false, "verbs": ["get", "list", "patch"]}
      ]
    },
    "publication": {"enabled": true, "toolPrefix": "mihomos"}
  }
}
