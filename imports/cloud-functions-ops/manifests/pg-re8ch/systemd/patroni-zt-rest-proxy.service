[Unit]
Description=Expose Patroni REST health on the restricted-node-6dc3f140f9 ZeroTier address
After=network-online.target patroni.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8008,bind=192.0.2.178,reuseaddr,fork TCP:192.0.2.169:8008
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
