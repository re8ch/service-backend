VOICE_LISTEN=192.0.2.169
VOICE_PORT=18092
VOICE_DB=/var/lib/re8ch-voice/voice.db
VOICE_ALLOWED_TENANTS=example-tenant
VOICE_API_HMAC_SECRET=REPLACE_API_HMAC_SECRET
FREESWITCH_ESL_PASSWORD=REPLACE_ESL_PASSWORD
# Comma-separated SIP Digest accounts. Deployment generates four random
# credentials when this is omitted; never commit the generated value.
# VOICE_AGENTS=agent01:hex-secret,agent02:hex-secret
DASHSCOPE_API_KEY=REPLACE_ME
DASHSCOPE_WORKSPACE_ID=REPLACE_ME
DASHSCOPE_ASR_MODEL=paraformer-realtime-8k-v2
DASHSCOPE_WS_URL=wss://REPLACE_WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
