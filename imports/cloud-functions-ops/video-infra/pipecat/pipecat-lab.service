[Unit]
Description=Pipecat restricted-node-6dc3f140f9 WebRTC voice lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pipecat
Group=pipecat
WorkingDirectory=/opt/pipecat
EnvironmentFile=-/etc/pipecat/pipecat.env
Environment=NLTK_DATA=/var/lib/pipecat/nltk_data
ExecStart=/opt/pipecat/.venv/bin/python /opt/pipecat/pipecat_echo.py --host 0.0.0.0 --port 7860 --transport webrtc --ws-auth token
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pipecat
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
