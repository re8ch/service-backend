{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re8ch.com/schemas/release-accepted-state.schema.json",
  "title": "Persisted accepted release state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "lastOperationId", "appliedDigest", "inventoryDigest", "inventory", "sequence", "updatedAt", "blocked"],
  "properties": {
    "schemaVersion": {"const": "delivery.re8ch.com/accepted-state/v1alpha1"},
    "releaseId": {"type": "string", "minLength": 1},
    "lastOperationId": {"type": "string", "format": "uuid"},
    "appliedDigest": {"$ref": "#/$defs/digest"},
    "healthyDigest": {"$ref": "#/$defs/digest"},
    "inventoryDigest": {"$ref": "#/$defs/digest"},
    "inventory": {"type": "array", "items": {"type": "string"}},
    "sequence": {"type": "integer", "minimum": 1},
    "updatedAt": {"type": "string", "format": "date-time"},
    "blocked": {"type": "boolean"},
    "blockedReason": {"type": "string"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
