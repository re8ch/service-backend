{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.re8ch.com/tenant-resource-claim.v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "tenancy.re8ch.com/v1alpha1"},
    "kind": {"const": "TenantResourceClaim"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "tenantRef"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "tenantRef": {"$ref": "#/$defs/name"},
        "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "ttlSeconds", "parameters"],
      "properties": {
        "capability": {"enum": ["image.run.v1", "database.run.v1", "network.service-binding.v1", "storage.volume.v1", "storage.bucket.v1"]},
        "ttlSeconds": {"type": "integer", "minimum": 300, "maximum": 2592000},
        "parameters": {"type": "object"},
        "consumer": {
          "type": "object", "additionalProperties": false,
          "required": ["cluster"],
          "properties": {
            "cluster": {"enum": ["qwen", "artc", "external"]},
            "serviceAccount": {"$ref": "#/$defs/name"},
            "publicEdgeRef": {"$ref": "#/$defs/name"}
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
  }
}
