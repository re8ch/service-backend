{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.re8ch.com/project-binding.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "governance.re8ch.com/v1alpha1"},
    "kind": {"const": "ProjectBinding"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "identity", "workspace", "contract"],
      "properties": {
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog", "repository", "catalogPath", "submodulePath"],
          "properties": {
            "catalog": {"type": "string"},
            "repository": {"type": "string"},
            "catalogPath": {"type": "string"},
            "submodulePath": {"type": "string"}
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maintainerAddress", "accountClass", "googleWorkspacePolicy"],
          "properties": {
            "maintainerAddress": {"type": "string", "format": "email"},
            "accountClass": {"enum": ["project-maintainer", "collaboration", "external-readonly", "platform-root"]},
            "googleWorkspacePolicy": {"enum": ["eligible", "not-requested", "external"]}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "oneActivePerAccount", "branchPrefix"],
          "properties": {
            "name": {"type": "string"},
            "oneActivePerAccount": {"const": true},
            "branchPrefix": {"type": "string", "pattern": "^workspace/"}
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "completion", "evidenceAuthority"],
          "properties": {
            "transport": {"const": "branch-pull-request"},
            "completion": {"const": "pull-request-closed"},
            "evidenceAuthority": {"const": "kubernetes"}
          }
        }
      }
    }
  }
}
