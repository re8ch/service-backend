{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "modules"],
  "properties": {
    "apiVersion": {"const": "workspace.re8ch.com/v1alpha1"},
    "kind": {"const": "WorkspaceLock"},
    "metadata": {"type": "object", "required": ["generation", "generatedAt", "schemaHash"]},
    "modules": {"type": "object", "additionalProperties": {"type": "object", "required": ["repository", "commit", "defaultBranch"], "properties": {"repository": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "defaultBranch": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}}}}}
  }
}
