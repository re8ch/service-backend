{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.re8ch.com/tenant-service-instance.v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "tenancy.re8ch.com/v1alpha1"},
    "kind": {"const": "TenantServiceInstance"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "idempotencyKey"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}, "maxProperties": 32}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceClass", "planRef", "regionRef", "desiredState", "parameters"],
      "properties": {
        "serviceClass": {"enum": ["database.postgresql.shared.v1", "storage.volume.v1", "storage.bucket.v1", "network.tenant.v1", "network.among-clusters.v1"]},
        "planRef": {"$ref": "#/$defs/name"},
        "regionRef": {"$ref": "#/$defs/name"},
        "desiredState": {"enum": ["Ready", "Suspended", "Deleted"]},
        "parameters": {"type": "object"}
      }
    }
  },
  "$defs": {"name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}}
}
