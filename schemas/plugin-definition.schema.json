{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.re8ch.com/plugin-definition.v1alpha1.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "plugins.re8ch.com/v1alpha1"},
    "kind": {"const": "PluginDefinition"},
    "metadata": {"type": "object", "required": ["name"]},
    "spec": {
      "type": "object",
      "required": ["source", "identityRef", "policy", "publication"],
      "properties": {
        "source": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["kubernetes", "openapi", "cli", "remoteMcp"]}}},
        "identityRef": {"type": "string", "minLength": 1},
        "policy": {"type": "object", "required": ["allowedOperations", "deniedFields"]},
        "publication": {"type": "object", "required": ["enabled", "toolPrefix"]}
      }
    }
  }
}
